# /etc/giq/giq.env — read by giq.service (EnvironmentFile=). Keep it
# root:giq, mode 0640: it holds the access token. install-debian.sh creates
# it from this file once and never overwrites it. After editing:
#   systemctl restart giq
#
# systemd syntax: KEY=value, one per line, no `export`, no shell expansion.

# Shared secret every API client must send (Authorization: Bearer <token>,
# X-Giq-Token: <token>, or ?token=<token>). Outranks access.token in
# config.yaml, so the secret can live here, readable by root and the service
# only, rather than in a world-readable config that every backup of GIQ_HOME
# copies. Generate one with
#   openssl rand -hex 32
# Leave it empty only if giq is reachable from this host alone.
GIQ_TOKEN=

# Where giq listens. Behind a reverse proxy on the same host, keep loopback.
# To serve the LAN directly, bind an interface address or 0.0.0.0 — and set
# the token above and a firewall rule first.
#GIQ_HOST=127.0.0.1
#GIQ_PORT=8084

# Default card for models that name none: an index or an NVML UUID.
#GIQ_GPU_DEVICE=GPU-00000000-0000-0000-0000-000000000000

# Directory overrides, when one part of the layout lives on another disk. A
# directory giq writes to must also be added to the unit's ReadWritePaths
# (systemctl edit giq).
#GIQ_MODELS_DIR=/srv/models
#GIQ_CACHE_DIR=/srv/giq-cache

# Pinned engine builds, outranking engines/<engine>/bin and config.yaml.
#GIQ_LLAMA_BINARY=/projects/giq/engines/llama.cpp/bin/llama-server
#GIQ_SDCPP_BINARY=/projects/giq/engines/sd.cpp/bin/sd-server

# Libraries the engines load from outside the dynamic linker's configured
# paths (a CUDA toolkit under /usr/local/cuda without an ld.so.conf entry).
#LD_LIBRARY_PATH=/usr/local/cuda/lib64
